# ── Core ──────────────────────────────────────────────────────────────────────
BOT_NAME=GitHub Community Bot
DEFAULT_LOCALE=en
# en | zh | ja (or a regional value such as zh-CN)
DATA_DIR=./data
DATABASE_PATH=./data/community.db
LOG_LEVEL=INFO
LOG_FORMAT=text
COMMAND_PREFIXES=!,/
ALLOW_REMOTE_SHUTDOWN=false

# ── Local AI: Ollama (free, open source, runs on your machine) ───────────────
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TEMPERATURE=0.6
OLLAMA_MAX_TOKENS=512
OLLAMA_HEALTH_CACHE_SECONDS=30

# ── GitHub ───────────────────────────────────────────────────────────────────
# Fine-grained token: Metadata (read), Contents (read), Issues (read),
# Pull requests (read). Classic token: public_repo (or repo for private repos).
GITHUB_TOKEN=
# Optional bootstrap repository. It can also be set later with !set_repo.
GITHUB_REPO=
GITHUB_API_URL=https://api.github.com
GITHUB_POLL_INTERVAL_SECONDS=300
# Recommended for instant updates. Use the same value in the GitHub webhook UI.
GITHUB_WEBHOOK_SECRET=
GITHUB_REQUEST_TIMEOUT_SECONDS=30

# ── HTTP: health, metrics, generic bridge and GitHub webhook ──────────────────
HTTP_ENABLED=true
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_MAX_BODY_BYTES=1048576
# Generate with: openssl rand -hex 32
# If empty, the generic /api/v1/messages bridge is disabled (a safe default).
BRIDGE_SHARED_SECRET=

# ── Discord ──────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
# Leave commented to enable automatically when the token is present.
# DISCORD_ENABLED=true
DISCORD_ADMIN_IDS=
# Comma-separated channel IDs. Empty means every channel the bot can read.
DISCORD_CHANNEL_IDS=
DISCORD_SYNC_COMMANDS=true
DISCORD_COMMAND_PREFIX=!

# ── Slack (Socket Mode) ──────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# SLACK_ENABLED=true
SLACK_ADMIN_IDS=
SLACK_CHANNEL_IDS=

# ── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# TELEGRAM_ENABLED=true
TELEGRAM_ADMIN_IDS=
TELEGRAM_CHAT_IDS=
TELEGRAM_API_BASE=https://api.telegram.org

# ── Matrix ──────────────────────────────────────────────────────────────────
# Unencrypted community rooms only. See docs/PLATFORMS.md.
MATRIX_HOMESERVER=
MATRIX_USER_ID=
MATRIX_ACCESS_TOKEN=
# MATRIX_ENABLED=true
MATRIX_ADMIN_IDS=
MATRIX_ROOM_IDS=

# ── Generic bridge ──────────────────────────────────────────────────────────
BRIDGE_PLATFORM_NAME=bridge
BRIDGE_ADMIN_IDS=

# ── Safety and retention ────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30
MAX_AI_INPUT_CHARS=2000
MAX_CONTEXT_MESSAGES=6
LEADERBOARD_SIZE=10
RETENTION_DAYS=365
